#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$(command -v pbpctrl 2>/dev/null || true)"
if [ -z "$BIN" ] && [ -x "$HOME/.cargo/bin/pbpctrl" ]; then
    BIN="$HOME/.cargo/bin/pbpctrl"
elif [ -z "$BIN" ] && [ -x "$HOME/.local/bin/pbpctrl" ]; then
    BIN="$HOME/.local/bin/pbpctrl"
elif [ -z "$BIN" ] && [ -x "$DIR/bin/pbpctrl" ]; then
    BIN="$DIR/bin/pbpctrl"
fi

if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
    echo "Error: 'pbpctrl' executable not found on PATH." >&2
    echo "Please install pbpctrl: cargo install --git https://github.com/qzed/pbpctrl.git" >&2
    exit 1
fi

DAEMON_SOCK="${XDG_RUNTIME_DIR:-/tmp/pixelbuds_$(id -u)}/pbpctrl.sock"
if [ -S "$DAEMON_SOCK" ] && command -v pbpctrld >/dev/null 2>&1; then
    case "$1" in
        anc)
            if [ -z "$2" ]; then
                pbpctrld get-anc
            elif [ "$2" = "cycle" ] || [ "$2" = "toggle" ]; then
                pbpctrld cycle-anc
            else
                pbpctrld set-anc "$2"
            fi
            exit 0
            ;;
        cycle-anc|cycle)
            pbpctrld cycle-anc
            exit 0
            ;;
        battery|bat)
            pbpctrld battery
            exit 0
            ;;
        status|info)
            pbpctrld status
            exit 0
            ;;
        gesture|hold)
            if [ -z "$2" ]; then
                pbpctrld get-gesture
            else
                pbpctrld set-gesture both "$2"
            fi
            exit 0
            ;;
    esac
fi

DEVICE="${DEVICE:-$(bluetoothctl devices Connected 2>/dev/null | grep -iE 'pixel buds|pixelbuds' | head -n1 | awk '{print $2}')}"
if [ -z "$DEVICE" ]; then
    echo "Error: No connected Pixel Buds detected." >&2
    echo "Please connect your earbuds or specify DEVICE=<bluetooth-mac> ./pixelbuds" >&2
    exit 1
fi

LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp/pixelbuds_$(id -u)}"
mkdir -p "$LOCK_DIR"
chmod 700 "$LOCK_DIR" 2>/dev/null || true
LOCK="$LOCK_DIR/pixelbuds_pbpctrl.lock"
run_pbp() {
    if command -v flock >/dev/null 2>&1; then
        flock -w 6 "$LOCK" "$BIN" -d "$DEVICE" "$@"
    else
        "$BIN" -d "$DEVICE" "$@"
    fi
}

case "$1" in
    battery|bat)
        if [ -x "$GFPS" ]; then
            "$GFPS" "$DEVICE"
        else
            run_pbp show battery
        fi
        ;;
    anc)
        if [ -z "$2" ]; then
            echo "Current ANC state:"
            run_pbp get anc
            echo "ANC Gesture Loop:"
            run_pbp get anc-gesture-loop
        else
            run_pbp set anc "$2"
        fi
        ;;
    eq)
        if [ -z "$2" ]; then
            run_pbp get eq
        else
            run_pbp set eq "$2" "$3" "$4" "$5" "$6"
        fi
        ;;
    gesture|hold)
        if [ -z "$2" ]; then
            echo "Current Hold Gesture action:"
            run_pbp get gesture-control
        else
            act="$2"
            if [ "$act" = "toggle" ]; then
                curr="$(run_pbp get gesture-control | tr '[:upper:]' '[:lower:]')"
                if [[ "$curr" == *"anc"* ]]; then
                    act="assistant"
                else
                    act="anc"
                fi
            fi
            run_pbp set gesture-control "$act" "$act"
            echo "Hold Gesture set to: $act"
        fi
        ;;
    info|status)
        echo "=== Hardware ==="
        run_pbp show hardware
        echo ""
        echo "=== Software ==="
        run_pbp show software
        echo ""
        echo "=== Runtime & Battery ==="
        run_pbp show runtime
        ;;
    *)
        run_pbp "$@"
        ;;
esac
